{
  "name": "4gaboards-mcp",
  "version": "0.1.0",
  "description": "MCP server for 4ga Boards (self-hosted kanban)",
  "type": "module",
  "license": "MIT",
  "bin": {
    "4gaboards-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
