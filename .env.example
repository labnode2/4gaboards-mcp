# Base URL of your 4ga Boards instance (no trailing /api)
FOURGA_URL=https://boards.example.lan

# Auth option A (recommended): API client (Settings -> Authentication in 4ga Boards)
FOURGA_CLIENT_ID=
FOURGA_CLIENT_SECRET=
# Auth option B: username/password (not usable for SSO-only accounts)
FOURGA_USERNAME=
FOURGA_PASSWORD=
# Auth option C: static bearer token (cannot be refreshed)
FOURGA_TOKEN=

# Deletes are hidden unless true
FOURGA_ALLOW_DELETE=false
# Optional focus mode: restrict every tool to one board
FOURGA_DEFAULT_BOARD_ID=

# HTTP transport only (node dist/index.js --http)
# With Docker, host/port are set by compose.yaml: leave them commented out.
#MCP_HTTP_HOST=127.0.0.1
#MCP_HTTP_PORT=3000
# Required as soon as the server listens on anything other than loopback (openssl rand -hex 32)
MCP_HTTP_TOKEN=
#MCP_HTTP_ALLOWED_HOSTS=mcp-host:3000
